{
  "name": "REPLACE_WITH_EXISTING_WORKER_NAME",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "CLICK_RATE_LIMITER",
      "namespace_id": "2026090801",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
